{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duo Radar",
  "version": "1.4.4",
  "identifier": "com.jiawei11.duoradar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Duo Radar · Jiawei",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGRjFBNDk2MERFMDVGQTYKUldTbVgrQU5scVR4TDhRN3hqR2FEN3dKVTB6dy96c0xEVlJVRFFrQVlxMGRscC9yQ0lqZVBsVUIK",
      "endpoints": [
        "https://github.com/Jiawei11/duo-radar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
