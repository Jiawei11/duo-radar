{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Duo: Run development / 开发运行",
      "type": "shell",
      "command": "$env:PATH = \"$env:USERPROFILE\\.cargo\\bin;\" + $env:PATH; pnpm tauri dev",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Duo: Build Windows exe / 构建 Windows exe",
      "type": "shell",
      "command": "$env:PATH = \"$env:USERPROFILE\\.cargo\\bin;\" + $env:PATH; pnpm tauri build --bundles nsis",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
